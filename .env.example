# Salin file ini menjadi .env, lalu sesuaikan. .env tidak ikut di-commit.
# Variabel yang di-set di terminal mengalahkan isi file ini.

# production (default) atau staging
TEST_ENV=production

# Opsional: timpa URL staging (default https://staging.vocagame.dev)
STAGING_URL=

# 1 = jalankan test @creates-order (klik Buy), 0 = lewati.
# Kosongkan untuk memakai ordersByDefault di tests/fixtures/env.ts.
RUN_ORDERS=

# Wajib: akun test (data pribadi, jangan di-commit)
TEST_EMAIL=you@example.com
# Akun Mobile Legends sungguhan; nickname tampil setelah User ID dan Zone ID diisi
TEST_USER_ID=
TEST_ZONE_ID=
TEST_NICKNAME=
